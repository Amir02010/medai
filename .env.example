# Скопируйте в .env.local (локально) или добавьте в Vercel → Settings → Environment Variables

# gemini | anthropic | openai
# gemini — у Google есть бесплатный тариф, карта не нужна
AI_PROVIDER=gemini

# Ключ. НИКОГДА не коммитьте настоящий ключ в репозиторий.
#   gemini    -> aistudio.google.com/apikey
#   anthropic -> platform.claude.com/settings/keys
#   openai    -> platform.openai.com/api-keys
AI_API_KEY=

# Необязательно: конкретная модель
# AI_MODEL=gemini-2.5-flash             # бесплатный тариф
# AI_MODEL=claude-haiku-4-5-20251001    # ~$1/$5 за 1M токенов
# AI_MODEL=claude-sonnet-5              # ~$2/$10, лучше разбирает симптомы
# AI_MODEL=gpt-5.6-luna                 # ~$0.20/$1.20

# Необязательно: если бэкенд живёт на другом домене
# REACT_APP_API_URL=https://api.example.com/chat
